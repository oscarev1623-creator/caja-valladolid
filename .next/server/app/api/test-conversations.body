 Rubio","userPhone":"8117205443","status":"active","assignedToId":"cmnsy3xqk0000vkeklu9n9e2f","assignedAt":"2026-04-14T20:39:16.284Z","createdAt":"2026-04-14T20:39:16.171Z","updatedAt":"2026-04-21T01:07:21.538Z","leadId":"cmnyjpf77000512kqibdu2907","assignedTo":{"id":"cmnsy3xqk0000vkeklu9n9e2f","email":"rebecagonzalezmx20@gmail.com","password":"$2b$10$a/WaWHXjf3oxdz9VCXqD0Oj.7oYlpVOQarn0DBfi4WLqa954ySWq2","name":"Rebeca González ","role":"agent","isActive":true,"color":"blue","createdAt":"2026-05-01T20:01:20.675Z","updatedAt":"2026-05-01T20:01:20.675Z"},"messages":[{"id":"cmo7orgou0009lfq7h8ata4bj","conversationId":"cmnyujl560000innczb2ov58u","senderType":"agent","message":"https://caja-valladolid.vercel.app/formulario-documentos/73b976b6-b297-408a-8a78-5fdeba224bcf","fileUrl":null,"fileType":null,"fileName":null,"isRead":true,"createdAt":"2026-04-21T01:07:21.532Z"}]},{"id":"cmnyujx6r000a1le5wz2gckzr","userEmail":"mg63043@gmail.com","userName":"Miguel Angel González Miranda","userPhone":"4423294709","status":"active","assignedToId":"cmnsy3xqk0000vkeklu9n9e2f","assignedAt":"2026-04-14T20:39:31.904Z","createdAt":"2026-04-14T20:39:31.780Z","updatedAt":"2026-04-23T17:32:33.892Z","leadId":"cmobfq8d7000t14lnvqvv5px9","assignedTo":{"id":"cmnsy3xqk0000vkeklu9n9e2f","email":"rebecagonzalezmx20@gmail.com","password":"$2b$10$a/WaWHXjf3oxdz9VCXqD0Oj.7oYlpVOQarn0DBfi4WLqa954ySWq2","name":"Rebeca González ","role":"agent","isActive":true,"color":"blue","createdAt":"2026-05-01T20:01:20.675Z","updatedAt":"2026-05-01T20:01:20.675Z"},"messages":[{"id":"cmobiu5ep0003gix28sgjxlvv","conversationId":"cmnyujx6r000a1le5wz2gckzr","senderType":"agent","message":"https://caja-valladolid.vercel.app/formulario-documentos/032c0485-7330-44f5-82c0-60324447af38","fileUrl":null,"fileType":null,"fileName":null,"isRead":true,"createdAt":"2026-04-23T17:32:33.889Z"}]},{"id":"cmo0v6ahb000czdl7adpzfv8l","userEmail":"enrique_197879@hotmail.com","userName":"Enrique Espinosa Lortia","userPhone":"+525517716386","status":"active","assignedToId":"cmnsy3xqk0000vkeklu9n9e2f","assignedAt":"2026-04-16T06:32:28.074Z","createdAt":"2026-04-16T06:32:27.792Z","updatedAt":"2026-04-30T17:47:55.539Z","leadId":"cmo0uo1va00012u0u96n98w6l","assignedTo":{"id":"cmnsy3xqk0000vkeklu9n9e2f","email":"rebecagonzalezmx20@gmail.com","password":"$2b$10$a/WaWHXjf3oxdz9VCXqD0Oj.7oYlpVOQarn0DBfi4WLqa954ySWq2","name":"Rebeca González ","role":"agent","isActive":true,"color":"blue","createdAt":"2026-05-01T20:01:20.675Z","updatedAt":"2026-05-01T20:01:20.675Z"},"messages":[{"id":"cmoljfple001910ukbcwydocg","conversationId":"cmo0v6ahb000czdl7adpzfv8l","senderType":"agent","message":"Etapa de Formalización y Requisitos de Garantía**\n\n**Estimado Cliente**, para dar continuidad al proceso y proceder con la **liquidación de los fondos aprobados**, el siguiente paso consiste en la **Formalización Legal y Administrativa de la operación**.\n\n**Con el fin de respaldar la obligación crediticia, se requiere la constitución de una (1) de las siguientes garantías**:\n**1. Garantía Real (Física)**\nSe requiere el respaldo de un bien mueble o inmueble, cuya valoración comercial debe representar, como mínimo, una relación de **2 a 1** respecto al monto total solicitado **(cobertura del 200%)**.\n**2. Garantía de Seguro (Póliza de Seguro)**\nCon el fin de mitigar el riesgo de insolvencia y proteger la operación, **se debe emitir una póliza de seguro de crédito bajo las siguientes categorías de costo:**\n**Póliza Tipo I:** Para montos menores o iguales a **$100.000**, el costo de la prima es de **($1.132,82).**\n**Póliza Tipo II:** Para montos superiores a **$100.000**, el costo de la prima es de **($2.211,82).**\nEsta póliza actúa como un mecanismo de protección para la entidad ante cualquier eventualidad que impida el cumplimiento de las obligaciones pactadas.","fileUrl":null,"fileType":null,"fileName":null,"isRead":true,"createdAt":"2026-04-30T17:47:01.586Z"}]},{"id":"cmnyvyq8b000e10ht0xg13s7e","userEmail":"payo.arias@hotmail.com","userName":"Mario Arias Mendoza","userPhone":"4613448946","status":"active","assignedToId":"cmnsy3xqk0000vkeklu9n9e2f","assignedAt":"2026-04-14T21:19:02.327Z","createdAt":"2026-04-14T21:19:02.164Z","updatedAt":"2026-04-22T17:22:05.844Z","leadId":"cmnyvyktt000hvb62ic4giwxi","assignedTo":{"id":"cmnsy3xqk0000vkeklu9n9e2f","email":"rebecagonzalezmx20@gmail.com","password":"$2b$10$a/WaWHXjf3oxdz9VCXqD0Oj.7oYlpVOQarn0DBfi4WLqa954ySWq2","name":"Rebeca González ","role":"agent","isActive":true,"color":"blue","createdAt":"2026-05-01T20:01:20.675Z","updatedAt":"2026-05-01T20:01:20.675Z"},"messages":[{"id":"cmoa30u4w002wmfkmcjjywtcr","conversationId":"cmnyvyq8b000e10ht0xg13s7e","senderType":"agent","message":"https://caja-valladolid.vercel.app/formulario-documentos/db93e068-b6ac-401f-9371-30823d153457","fileUrl":null,"fileType":null,"fileName":null,"isRead":true,"createdAt":"2026-04-22T17:22:05.840Z"}]},{"id":"cmnyvgk6t0000w8pou0sf0vdc","userEmail":"condeatc@gmail.com","userName":"Santiago Arturo Torres conde","userPhone":"3312209175","status":"active","assignedToId":"cmnsy3xqk0000vkeklu9n9e2f","assignedAt":"2026-04-14T21:04:54.795Z","createdAt":"2026-04-14T21:04:54.580Z","updatedAt":"2026-04-22T17:27:48.930Z","leadId":"cmnyvg3hp0001vb62q8i41za7","assignedTo":{"id":"cmnsy3xqk0000vkeklu9n9e2f","email":"rebecagonzalezmx20@gmail.com","password":"$2b$10$a/WaWHXjf3oxdz9VCXqD0Oj.7oYlpVOQarn0DBfi4WLqa954ySWq2","name":"Rebeca González ","role":"agent","isActive":true,"color":"blue","createdAt":"2026-05-01T20:01:20.675Z","updatedAt":"2026-05-01T20:01:20.675Z"},"messages":[{"id":"cmoa386v1002lks3k6lfnbshs","conversationId":"cmnyvgk6t0000w8pou0sf0vdc","senderType":"agent","message":"https://caja-valladolid.vercel.app/formulario-documentos/20b8cc82-29d1-429f-8616-e3501c717133","fileUrl":null,"fileType":null,"fileName":null,"isRead":true,"createdAt":"2026-04-22T17:27:48.926Z"}]},{"id":"cmnyvj38v0001w8pofekc7klz","userEmail":"arcenalmarco0@gmail.com","userName":"Marco Anton